  "_eligibility": "A type applies when one of its terms is in the TITLE, or at least min_description_hits distinct terms are in the description. A single hit in a long description is usually boilerplate ('personal guidance' in a foundation blurb).",
  "min_description_hits": 2,
  "_provisional_v2": "fleet_orders and community_csr were widened and airport_infrastructure, partnerships_mna, regulation_policy, sustainability_saf and workforce_hr added with provisional weights; all pending user approval. Typing is skipped for the guarded types for stories the relevance exclusion lists (defence, investment commentary) remove.",
  "typing_exclusions": {
    "_doc": "Exclusion lists run BEFORE type matching: an article whose title hits selection.exclude_terms (and no keep_terms) or commentary.title_patterns in config/relevance.json gets none of the guarded types, so 'agreement' in a missile-deal headline cannot become partnerships_mna. The lists themselves stay in relevance.json (one source of truth).",
    "guarded_types": [
      "fleet_orders",
      "airport_infrastructure",
      "partnerships_mna",
      "regulation_policy",
      "sustainability_saf",
      "workforce_hr"
    ]
  }
