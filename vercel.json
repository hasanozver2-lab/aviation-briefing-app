{
  "version": 2,
  "rewrites": [
    { "source": "/api/briefing", "destination": "/api/index.py" },
    { "source": "/api/refresh", "destination": "/api/index.py" },
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/static/(.*)", "destination": "/static/$1" },
    { "source": "/", "destination": "/static/index.html" }
  ],
  "crons": [
    {
      "path": "/api/briefing?mode=daily&refresh=true",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/briefing?mode=hourly&refresh=true",
      "schedule": "0 * * * *"
    }
  ]
}
